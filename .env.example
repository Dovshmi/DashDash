# Gmail account used only to send DashDash notifications.
# Add the real values in Vercel → Project → Settings → Environment Variables.
# Never commit a file containing real credentials.
GMAIL_SMTP_USER=notifications@example.com
GMAIL_SMTP_APP_PASSWORD=replace-with-a-google-app-password

# The deployed site origin, without a trailing slash.
APP_ORIGIN=https://your-dashdash-domain.vercel.app

# Optional display name and sender address. Leave unset to use GMAIL_SMTP_USER.
MAIL_FROM=DashDash <notifications@example.com>
